APP_NAME="DMS Backend"
ENVIRONMENT=production
INFERENCE_RUNNER=bamti-torch

# Container paths. The backend compose file mounts ../model to /models.
MODEL_PATH=/models/exp04_pseudo_ir_aug.pth
AIHUB_MODEL_PATH=/models/final_model.pth
DRIVER4_MODEL_PATH=/models/final_model_4cls.pth

MODEL_DEVICE=cuda
MODEL_INPUT_SIZE=224
MODEL_SCORE_ACTIVATION=softmax

# DGX notes:
# - This backend process uses one CUDA device by default.
# - Keep DGX_GPU_DEVICE and NVIDIA_VISIBLE_DEVICES aligned.
DGX_GPU_DEVICE=0
NVIDIA_VISIBLE_DEVICES=0
NVIDIA_DRIVER_CAPABILITIES=compute,utility
CUDA_DEVICE_ORDER=PCI_BUS_ID

# Keep CPU-side preprocessing conservative so it does not fight other DGX jobs.
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
TORCH_NUM_THREADS=4
DRIVER4_V7_ACTIVATION_THRESHOLD=0.5
DRIVER4_V7_CHARGE_RATE=35
DRIVER4_V7_DECAY_RATE=20
DRIVER4_V7_WARNING_THRESHOLD=70
DRIVER4_V7_MAX_DELTA_SECONDS=0.5
DRIVER4_V7_RESET_GAP_SECONDS=2.0
TORCH_COMPILE_BACKEND=inductor
TORCH_COMPILE_MODE=reduce-overhead

TELEMETRY_RUNS_DIR=/app/telemetry_runs
MAX_FRAME_BYTES=1048576

# Database is not required for active inference routes.
DATABASE_URL=mysql+aiomysql://dms_user:change-me@mysql:3306/dms

MYSQL_DATABASE=dms
MYSQL_USER=dms_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

PUBLIC_DOMAIN=localhost
